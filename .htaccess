# fluharty.link server config (cPanel / Apache or LiteSpeed)
# Clean URLs: /now serves now.html, and old /now.html links 301 to /now.

Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On

# repo files that are not part of the site
RewriteRule (^|/)\.(git|claude)(/|$) - [F,L]
RewriteRule \.(md|py)$ - [F,L]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# /page.html -> /page
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /page/ -> /page (directories keep their slash)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# /page -> page.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^ %{REQUEST_URI}.html [L]
